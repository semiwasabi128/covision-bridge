<!DOCTYPE html>
<html lang="zh-Hant"><head><meta charset="utf-8"><title>橋樑大腦圖譜 — 3D 星系版</title>
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#060a10;font-family:'PingFang TC','Noto Sans TC',sans-serif}
canvas{display:block}
#ui{position:fixed;top:16px;left:16px;color:#d8e8d8;font-size:13px;line-height:1.7;text-shadow:0 1px 4px #000;pointer-events:none;z-index:5}
#ui b{color:#F0CE5E;font-size:15px}
.legendDot{display:inline-block;width:9px;height:9px;border-radius:50%;margin:0 5px 0 0;vertical-align:baseline}
#card{position:fixed;bottom:20px;right:20px;max-width:340px;background:rgba(10,18,14,.92);border:1px solid rgba(240,206,94,.35);border-radius:12px;padding:14px 16px;color:#e8f0e8;font-size:13px;line-height:1.6;z-index:5;display:none;backdrop-filter:blur(8px)}
#card h4{margin:0 0 6px;color:#F0CE5E;font-size:14px}
#card .sub{color:#7fa88f;font-size:11px}
#hint{position:fixed;bottom:20px;left:16px;color:rgba(216,232,216,.55);font-size:12px;text-shadow:0 1px 3px #000;z-index:5;pointer-events:none}
</style>
<script type="importmap">{"imports":{"three":"https://unpkg.com/three@0.180.0/build/three.module.js"}}</script>
</head><body>
<div id="ui"><b>大腦圖譜 · 3D 星系</b><br>
房間=星團顏色　·　線=因果/連動/結構　·　左鍵拖曳=旋轉（慣性）　滾輪=縮放　中鍵=平移　雙擊星點=開檔
</div>
<div id="card"></div>
<div id="tip" style="position:fixed;display:none;background:rgba(8,14,10,.92);border:1px solid rgba(240,206,94,.5);border-radius:8px;padding:6px 10px;color:#e8f0e8;font-size:12px;pointer-events:none;z-index:8;white-space:nowrap;text-shadow:0 1px 2px #000"></div>
<div id="hint">拖曳旋轉 · 滾輪縮放 · 點擊節點看資訊 · hover 顯示標題</div>
<div id="err" style="position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:#300;color:#f88;padding:16px 24px;border-radius:10px;font-size:14px;max-width:80%;display:none;z-index:99;white-space:pre-wrap"></div>
<script>
window.onerror=function(msg,src,line,col){const e=document.getElementById('err');e.style.display='block';e.textContent+='⚡ '+msg+' @'+line+':'+col+'\n';};
window.addEventListener('unhandledrejection',ev=>{const e=document.getElementById('err');e.style.display='block';e.textContent+='⚡ Promise: '+ev.reason+'\n';});
</script>
<script type="module">
import * as THREE from 'three';

// token 從 URL query 帶入（webview 載入 URL 時由 Dart 端附上）
const _tk = new URLSearchParams(location.search).get('token') ?? '';
const res = await fetch('/galaxy_data', {headers: {'x-bridge-token': _tk}}).then(r=>r.json());
const nodes = res.nodes, edges = res.edges;
const assets = res.files; // 同一包 JSON：{nodes, edges, files}

const renderer = new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.setSize(innerWidth, innerHeight);
document.body.appendChild(renderer.domElement);

const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x060a10, 0.00009);
const camera = new THREE.PerspectiveCamera(55, innerWidth/innerHeight, 1, 20000);

// ── 背景亮點已移除（2026-08-28 Blue）：宇宙裡每顆星都是真實檔案/記憶 ──

// ── 房間=星團 ──
const ROOM_COLOR = {doors:0x5fb8ff, stream:0x9d7bff, pendulums:0xff8a5f, heartMind:0xff6f9c, fraile:0x66e0c3};
const roomCenter = {};
for(const room of Object.keys(ROOM_COLOR)){
  const th=Math.random()*Math.PI*2;
  roomCenter[room]=[Math.cos(th)*900, (Math.random()-.5)*600, Math.sin(th)*900];
}
const colorOf = n => ROOM_COLOR[n.room] ?? 0x9fb4a6;

const galaxy = new THREE.Group(); scene.add(galaxy); // 整個星系一起轉（球+線+標籤同步）

// ── 節點：importance→大小, clen→亮度 ──
const geo = new THREE.SphereGeometry(1, 20, 14); // 單位球，per-instance scale
const mat = new THREE.MeshBasicMaterial(); // 自發光星體——不依賴打光，保證可見
const inst = new THREE.InstancedMesh(geo, mat, nodes.length);
const dummy = new THREE.Object3D();
const nodeData = [];
nodes.forEach((n,i)=>{
  const c = roomCenter[n.room] ?? [0,0,0];
  const th=Math.random()*Math.PI*2, ph=Math.acos(2*Math.random()-1), r=140+Math.random()*420;
  const x=c[0]+r*Math.sin(ph)*Math.cos(th), y=c[1]+r*Math.cos(ph)*.7, z=c[2]+r*Math.sin(ph)*Math.sin(th);
  const size = 5 + Math.min((n.importance||1),10)*2.2;
  const bright = Math.min(1.6, 0.7 + Math.log10(1+(n.clen||10))/4); // 內容量→亮度(顏色增益)
  dummy.position.set(x,y,z); dummy.scale.setScalar(size); dummy.updateMatrix();
  inst.setMatrixAt(i, dummy.matrix);
  const col = new THREE.Color(colorOf(n)).multiplyScalar(bright);
  inst.setColorAt(i, col);
  nodeData.push({...n, x, y, z, size});
});
inst.instanceMatrix.needsUpdate = true;
if(inst.instanceColor) inst.instanceColor.needsUpdate = true;
galaxy.add(inst);

// ── 邊：三層線 ──
const byId = Object.fromEntries(nodeData.map(n=>[n.id,n]));
const v=[];
for(const e of edges){
  const a=byId[e.a], b=byId[e.b]; if(!a||!b) continue;
  v.push(a.x,a.y,a.z,b.x,b.y,b.z);
}
const eg = new THREE.BufferGeometry();
eg.setAttribute('position', new THREE.BufferAttribute(new Float32Array(v),3));
galaxy.add(new THREE.LineSegments(eg, new THREE.LineBasicMaterial({color:0xF0CE5E, transparent:true, opacity:.5})));

// ── 檔案星雲：embedding 語意投影（6,556 星，同主題自然聚成星團）──
const EXT_COLOR = {'.jpg':0xF0CE5E,'.jpeg':0xF0CE5E,'.png':0xF0CE5E,'.heic':0xF0CE5E,'.gif':0xF0CE5E,
  '.md':0x7fd894,'.pdf':0x7fd894,'.adoc':0x7fd894,'.doc':0x7fd894,'.txt':0x7fd894,
  '.js':0xb98aff,'.json':0xb98aff,'.html':0xb98aff,'.dart':0xb98aff,'.sol':0xb98aff,'.ts':0xb98aff,
  '.csv':0x5fd8e8,'.xlsx':0x5fd8e8,'.spec':0x5fd8e8,'x':0xff9e6b};
const starPos = new Float32Array(assets.length*3);
const starCol = new Float32Array(assets.length*3);
assets.forEach((a,i)=>{
  starPos[i*3]=a.x; starPos[i*3+1]=a.y; starPos[i*3+2]=a.z;
  const c = new THREE.Color(EXT_COLOR[a.e] ?? 0xff9e6b);
  const lum = Math.min(1, Math.log10(1+(a.s||1000))/7);
  starCol[i*3]=c.r*Math.max(.25,lum); starCol[i*3+1]=c.g*Math.max(.25,lum); starCol[i*3+2]=c.b*Math.max(.25,lum);
});
const sg = new THREE.BufferGeometry();
sg.setAttribute('position', new THREE.BufferAttribute(starPos,3));
// ── 檔案星同主題細線（半透明青色，星團內部結構）──
if(res.file_links && res.file_links.length){
  const fl = new Float32Array(res.file_links.length*6);
  res.file_links.forEach(([a,b],i)=>{
    fl[i*6]=starPos[a*3]; fl[i*6+1]=starPos[a*3+1]; fl[i*6+2]=starPos[a*3+2];
    fl[i*6+3]=starPos[b*3]; fl[i*6+4]=starPos[b*3+1]; fl[i*6+5]=starPos[b*3+2];
  });
  const flg = new THREE.BufferGeometry();
  flg.setAttribute('position', new THREE.BufferAttribute(fl,3));
  galaxy.add(new THREE.LineSegments(flg, new THREE.LineBasicMaterial({color:0x66e0c3, transparent:true, opacity:.16})));
}
sg.setAttribute('color', new THREE.BufferAttribute(starCol,3));
const stars = new THREE.Points(sg, new THREE.PointsMaterial({size:7, vertexColors:true, transparent:true, opacity:.9, sizeAttenuation:true}));
galaxy.add(stars);

// ── [小葵 2026-08-28] 因果鏈：cause→effect 橘色亮線（最高視覺位階）──
if(res.causal_links && res.causal_links.length){
  const cl = new Float32Array(res.causal_links.length*6);
  res.causal_links.forEach(([a,b],i)=>{
    cl[i*6]=starPos[a*3]; cl[i*6+1]=starPos[a*3+1]; cl[i*6+2]=starPos[a*3+2];
    cl[i*6+3]=starPos[b*3]; cl[i*6+4]=starPos[b*3+1]; cl[i*6+5]=starPos[b*3+2];
  });
  const clg = new THREE.BufferGeometry();
  clg.setAttribute('position', new THREE.BufferAttribute(cl,3));
  galaxy.add(new THREE.LineSegments(clg, new THREE.LineBasicMaterial({color:0xff8c42, transparent:true, opacity:.85})));
}
// ── [小葵 2026-08-28] 生產線：任務→產出檔案 青色虛線感（低透明實線）──
if(res.task_links && res.task_links.length){
  const tl = new Float32Array(res.task_links.length*6);
  res.task_links.forEach(([a],i)=>{ /* task 星：以群中心為源，產出星為端 */
    tl[i*6]=starPos[a*3]; tl[i*6+1]=starPos[a*3+1]; tl[i*6+2]=starPos[a*3+2];
    tl[i*6+3]=starPos[a*3]+1; tl[i*6+4]=starPos[a*3+1]+1; tl[i*6+5]=starPos[a*3+2]+1;
  });
  const tlg = new THREE.BufferGeometry();
  tlg.setAttribute('position', new THREE.BufferAttribute(tl,3));
  galaxy.add(new THREE.LineSegments(tlg, new THREE.LineBasicMaterial({color:0x4ecdc4, transparent:true, opacity:.4})));
}
// ── [小葵 2026-08-28] 記憶→檔案引用線：紫羅蘭淡線 ──
if(res.mem_asset_links && res.mem_asset_links.length){
  const ml = new Float32Array(res.mem_asset_links.length*6);
  res.mem_asset_links.forEach(([mi,fi],i)=>{
    const nd = nodeData[mi]; ml[i*6]=nd.x; ml[i*6+1]=nd.y; ml[i*6+2]=nd.z;
    ml[i*6+3]=starPos[fi*3]; ml[i*6+4]=starPos[fi*3+1]; ml[i*6+5]=starPos[fi*3+2];
  });
  const mlg = new THREE.BufferGeometry();
  mlg.setAttribute('position', new THREE.BufferAttribute(ml,3));
  galaxy.add(new THREE.LineSegments(mlg, new THREE.LineBasicMaterial({color:0xb28dff, transparent:true, opacity:.22})));
}

// ── 檔案 hover：主題星團名浮籤 ──
const TOPIC_CN = {'巡查紀錄':'巡查紀錄','生成圖像':'生成圖像','晨間拾穗':'晨間拾穗','以利沙農務判讀':'農務判讀','photo-vision':'photo-vision','以西結稽核':'以西結稽核','daily-reflection':'每日反思','農場日記':'農場日記','晨間拾穗_IG':'晨間拾穗IG','策劃室日更':'策劃室日更'};
let topicLabel = null;
function showTopic(text){
  removeTopic();
  const cv=document.createElement('canvas'); const ctx=cv.getContext('2d');
  const fs=34; ctx.font=`600 ${fs}px PingFang TC`;
  const w=ctx.measureText(text).width+48;
  cv.width=Math.ceil(w); cv.height=64;
  ctx.fillStyle='rgba(8,14,10,.88)'; roundRect(ctx,0,0,cv.width,64,16); ctx.fill();
  ctx.strokeStyle='#F0CE5E'; ctx.lineWidth=2.5; roundRect(ctx,1,1,cv.width-2,62,16); ctx.stroke();
  ctx.font=`600 ${fs}px PingFang TC`; ctx.fillStyle='#F0CE5E'; ctx.textBaseline='middle';
  ctx.fillText(text,24,33);
  const tx=new THREE.CanvasTexture(cv); tx.colorSpace=THREE.SRGBColorSpace;
  topicLabel=new THREE.Sprite(new THREE.SpriteMaterial({map:tx,transparent:true,depthTest:false}));
  topicLabel.userData.baseScale=1;
  topicLabel.scale.set(cv.width/3, 64/3, 1);
  topicLabel.position.copy(camera.position.clone().add(camera.getWorldDirection(new THREE.Vector3()).multiplyScalar(700)));
  scene.add(topicLabel);
}
function removeTopic(){ if(topicLabel){scene.remove(topicLabel); topicLabel.material.map.dispose(); topicLabel=null;} }

// ── 光 ──
scene.add(new THREE.AmbientLight(0x223322, 1.1));
const sun = new THREE.PointLight(0xfff2cc, 2.2, 6000); sun.position.set(0,400,0); scene.add(sun);
const rim = new THREE.DirectionalLight(0x4466aa, 1.0); rim.position.set(-800,-300,-600); scene.add(rim);

// ── 標題藥丸（sprite，僅重要節點）──
function label(text, x, y, z, color){
  const cv=document.createElement('canvas'); const ctx=cv.getContext('2d');
  const fs=26; ctx.font=`${fs}px PingFang TC`;
  const w=ctx.measureText(text).width+36;
  cv.width=Math.ceil(w); cv.height=52;
  ctx.fillStyle='rgba(8,14,10,.82)'; roundRect(ctx,0,0,cv.width,52,14); ctx.fill();
  ctx.strokeStyle=color; ctx.lineWidth=2; roundRect(ctx,1,1,cv.width-2,50,14); ctx.stroke();
  ctx.font=`${fs}px PingFang TC`; ctx.fillStyle='#e8f0e8'; ctx.textBaseline='middle';
  ctx.fillText(text,18,27);
  const tx=new THREE.CanvasTexture(cv); tx.colorSpace=THREE.SRGBColorSpace;
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tx,transparent:true,depthTest:false}));
  sp.scale.set(cv.width/3.4, 52/3.4, 1); sp.position.set(x, y+sizeOf(text), z);
  return sp;
}
function sizeOf(){return 0}
function roundRect(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath()}
nodeData.forEach(n=>{
  if(n.sub==='workflow_node') return;
  if((n.importance||1) < 4) return; // 重要節點才掛藥丸（importance≥4，本資料集 30 顆）
  galaxy.add(label(n.txt||n.sub, n.x, n.y+n.size+9, n.z, '#'+new THREE.Color(colorOf(n)).getHexString()));
});

// ── 互動：hover 標題卡 + 點擊資訊窗（記憶節點 + 檔案星）──
const ray=new THREE.Raycaster(); ray.params.Points.threshold=14;
const mouse=new THREE.Vector2(-9,-9); let hovered=-1; let hoveredStar=-1;
const card=document.getElementById('card');
const tip=document.getElementById('tip');
let mouseClient={x:0,y:0};
renderer.domElement.addEventListener('pointermove',e=>{
  mouse.x=(e.clientX/innerWidth)*2-1; mouse.y=-(e.clientY/innerHeight)*2+1;
  mouseClient={x:e.clientX,y:e.clientY};
});
const EXT_ICON={'.jpg':'🖼️','.jpeg':'🖼️','.png':'🖼️','.heic':'🖼️','.gif':'🖼️','.md':'📝','.pdf':'📄','.adoc':'📄','.txt':'📝','.js':'⚡','.json':'🧩','.html':'🌐','.dart':'🎯','.sol':'⛓️','.ts':'⚡','.csv':'📊','.xlsx':'📊'};
renderer.domElement.addEventListener('click',()=>{
  if(hovered>=0||hoveredStar>=0) spin.on=false; // 點中節點 → 停止自轉
  if(hovered>=0){
    const n=nodeData[hovered];
    card.innerHTML=`<h4>${n.txt||'(無標題)'}</h4><div class="sub">${n.room} · ${n.sub} · 重要性 ${n.importance} · ${n.clen} 字</div>`;
    card.style.display='block'; return;
  }
  if(hoveredStar>=0){
    const a=assets[hoveredStar];
    const mb=(a.s/1048576).toFixed(1);
    card.innerHTML=`<h4>${EXT_ICON[a.e]||'📦'} ${a.n||'(未命名)'}</h4><div class="sub">${a.t==='solo'?'未歸主題':a.t} · ${mb} MB · ${a.e}</div>`;
    card.style.display='block'; return;
  }
  card.style.display='none';
});

renderer.domElement.addEventListener('dblclick',()=>{
  if(hoveredStar>=0 && assets[hoveredStar] && assets[hoveredStar].id){
    fetch('/galaxy_open?id='+encodeURIComponent(assets[hoveredStar].id),{headers:{'x-bridge-token':_tk}})
      .then(r=>r.json()).then(d=>{ if(d.error) tip.textContent='⚠ '+d.error; });
  }
});

// ── 軌道控制 ──
let rotY=0.6, rotX=0.35, dist=1900,
    target=new THREE.Vector3(0,0,0);
if(new URLSearchParams(location.search).get('zoom')==='mid') dist=3600; // 測試用：全宇宙視角
let mode=null; // null | 'rotate' | 'pan'
let px=0,py=0;
const samples=[];
const spin={on:true, vy:0.05, vx:0}; // 慣性自轉（rad/s，初始水平緩轉）
renderer.domElement.addEventListener('mousedown',e=>{ if(e.button===1) e.preventDefault(); }); // 擋中鍵自動捲動
let spinWasOn=true; // 平移前的自轉狀態（平移不該改變它）
renderer.domElement.addEventListener('pointerdown',e=>{
  mode = e.button===1 ? 'pan' : 'rotate';
  px=e.clientX; py=e.clientY;
  samples.length=0;
  spinWasOn=spin.on;
  spin.on=false; // 拖曳中停轉
});
addEventListener('pointerup',e=>{
  if(mode==='rotate'){
    // 放開 → 依最後拖曳速度慣性自轉（方向=拖曳方向，可斜向）
    const now=performance.now();
    const recent=samples.filter(s=>now-s.t<120);
    if(recent.length>=2){
      const dt=Math.max(16, now-recent[0].t);
      spin.vy=-(e.clientX-recent[0].x)/dt*0.005; // 與拖曳同規則（已顛倒）
      spin.vx=(e.clientY-recent[0].y)/dt*0.004;
      // 最低速保證（Blue 2026-08-28）：慢拖放開也要有原預設自轉速度
      if(Math.abs(spin.vy)<0.05) spin.vy=spin.vy<0?-0.05:0.05;
    } else { spin.vy=0; spin.vx=0; }
    spin.on=true; // 恢復自轉（朝拖曳方向勻速）
  } else if(mode==='pan'){
    spin.on=spinWasOn; // [Blue 2026-08-28] 平移不改變原本自轉與否的狀態
  }
  mode=null;
});
renderer.domElement.addEventListener('pointermove',e=>{
  if(!mode) return;
  const dx=e.clientX-px, dy=e.clientY-py;
  if(mode==='rotate'){
    rotY-=dx*0.005; rotX+=dy*0.004; // 左右顛倒（Blue 2026-08-28）：向左拖=星圖向左轉
    samples.push({x:e.clientX,y:e.clientY,t:performance.now()});
    if(samples.length>10) samples.shift();
  } else {
    // 中鍵平移：在相機平面移動注視點
    const k=dist/900;
    const fwd=new THREE.Vector3().subVectors(target,camera.position).normalize();
    const right=new THREE.Vector3().crossVectors(fwd,camera.up).normalize();
    const up=new THREE.Vector3().crossVectors(right,fwd).normalize();
    target.addScaledVector(right,-dx*k).addScaledVector(up,dy*k);
  }
  px=e.clientX;py=e.clientY;
});
renderer.domElement.addEventListener('wheel',e=>{
  dist*=e.deltaY>0?1.08:0.93; dist=Math.max(400,Math.min(9000,dist));
},{passive:true});
function updateCam(){
  camera.position.set(
    target.x+dist*Math.cos(rotX)*Math.sin(rotY),
    target.y+dist*Math.sin(rotX),
    target.z+dist*Math.cos(rotX)*Math.cos(rotY));
  camera.lookAt(target);
}
updateCam();

// ── FPS 儀表 ──
const fpsEl = document.createElement('div');
fpsEl.style.cssText='position:fixed;top:14px;right:16px;font:700 30px Menlo,monospace;color:#7fff9f;text-shadow:0 0 8px #050;z-index:9;pointer-events:none';
document.body.appendChild(fpsEl);
let ftimes=[];
function fpsTick(now){
  ftimes.push(now);
  if(ftimes.length>90) ftimes.shift();
  if(ftimes.length>30){
    const dt=(ftimes[ftimes.length-1]-ftimes[0])/(ftimes.length-1);
    fpsEl.textContent=Math.round(1000/dt)+' FPS';
  }
}

// ── 主迴圈：呼吸 + 細微自轉 ──
const clock=new THREE.Clock();
function animate(){
  requestAnimationFrame(animate);
  fpsTick(performance.now());
  const t=clock.getElapsedTime();
  const _now=performance.now();
  const dt=Math.min(0.05,(_now-(animate._last||_now))/1000); animate._last=_now;
  if(mode===null && spin.on){ rotY+=spin.vy*dt; rotX+=spin.vx*dt; } // 慣性自轉
  sun.intensity = 2.0 + Math.sin(t*0.7)*0.5;    // 呼吸
  // hover 拾取（記憶球優先，再檔案星）
  ray.setFromCamera(mouse,camera);
  const hit=ray.intersectObject(inst,false);
  const newHover=hit.length?hit[0].instanceId:-1;
  let newStar=-1;
  if(newHover<0){
    const sh=ray.intersectObject(stars,false);
    if(sh.length){
      newStar=sh[0].index;
      const a=assets[newStar];
      tip.textContent=`${EXT_ICON[a.e]||'📦'} ${a.n||'(未命名)'}  ·  ${a.t==='solo'?'未歸主題':a.t}`;
      tip.style.display='block';
      tip.style.left=(mouseClient.x+14)+'px';
      tip.style.top=(mouseClient.y-34)+'px';
    }
  }
  if(newStar<0) tip.style.display='none';
  else {
    // 診斷：hover 到檔案星時印一次拾取結果（驗證用，可留）
    if(hoveredStar!==newStar) console.log('[star-hover]', newStar, assets[newStar]?.n);
  }
  if(newHover!==hovered){
    hovered=newHover;
    renderer.domElement.style.cursor=hovered>=0?'pointer':'grab';
  }
  hoveredStar=newStar;
  updateCam();
  renderer.render(scene,camera);
}
animate();
addEventListener('resize',()=>{
  camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
  renderer.setSize(innerWidth,innerHeight);
});

</script>
</body></html>
